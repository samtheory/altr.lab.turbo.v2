{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Apolyx registry item",
  "type": "object",
  "required": ["name", "type", "title", "description", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "type": {
      "type": "string",
      "enum": ["ui", "primitive", "motion", "chart", "lib", "theme"]
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "target"],
        "properties": {
          "path": { "type": "string", "description": "Kit-relative source path" },
          "target": { "type": "string", "description": "Path relative to the consumer alias for this item type" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "registryDependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cssVars": { "type": "object" },
    "docs": { "type": "string", "description": "Docs slug under /docs" }
  }
}
