# Forward Studio BFF routes to @altr/jord-server (Slice 0 default port).
JORD_SERVER_URL=http://127.0.0.1:8787

# Shared with jord-server — bearer / HMAC secret (required for S3).
JORD_SERVER_TOKEN=dev-jord-token-change-me

# Role when the raw token is used as Bearer on jord-server (default admin).
JORD_DEFAULT_ROLE=admin

# Studio operator login (HTTP-only session cookie).
JORD_STUDIO_PASSWORD=lab
JORD_STUDIO_ROLE=admin

# Lab-only: skip login UI and mint a session from env (still forwards bearer upstream).
JORD_STUDIO_OPEN=1
