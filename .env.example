# Shared env example (copy to .env locally as needed)

NODE_ENV=development

# Jord hosted libSQL / Turso (jord-server process)
# DATABASE_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=
TURSO_AUTH_TOKEN=

# Hono API
PORT=8787

# Jord control-plane project registry (cloud/jord). 32-byte AES key, 64-char hex.
# Local `pnpm dev` auto-provisions data/jord-master.key when unset (non-production).
# JORD_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

