{
  "name": "@altr/jord-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "dump:phase-01-baseline": "tsx scripts/dump-phase-01-baseline.ts",
    "storage:copy-plan": "tsx scripts/storage-copy-plan.ts",
    "lint": "echo \"No lint configured for @altr/jord-server yet\"",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@altr/jord": "workspace:*",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@hono/node-server": "^1.19.0",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.9.6",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@altr/jord-client": "workspace:*",
    "@types/node": "^22.16.5",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.2",
    "pg": "8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
