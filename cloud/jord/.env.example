JORD_SERVER_TOKEN=dev-jord-token-change-me
# Raw bearer is service_role. Set admin only as a temporary operator escape.
# JORD_LEGACY_SECRET_ROLE=service
JORD_DEFAULT_ROLE=admin
# Control-plane AES key for project registry (S0043). 32 bytes as 64-char hex.
# Outside production, jord-server auto-writes data/jord-master.key when unset.
# JORD_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# JORD_DEV_MASTER_KEY=0

# HS256 access tokens. Separate from JORD_SERVER_TOKEN.
# JORD_JWT_SECRET=
# JORD_JWT_SECRET_PREVIOUS=
# Comma-separated generated API resource ids disabled at boot (e.g. records)
# JORD_GENERATED_API_DISABLED=
# DATABASE_URL=file:./data/jord.db
# DATABASE_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=
# TURSO_AUTH_TOKEN=
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/jord
# Optional live-URL alias for backup/restore-drill guards (S0040):
# JORD_DATABASE_URL=
# When pg_dump/psql are not on PATH, name a running Postgres container:
# JORD_BACKUP_PG_CONTAINER=jord-pg
# PORT=8787
# S0028 HTTP hardening (defaults deny cross-origin / 1 MiB JSON / 120 data hits per minute):
# JORD_CORS_ORIGINS=https://studio.example,http://127.0.0.1:3005
# JORD_MAX_JSON_BYTES=1048576
# JORD_DATA_RATE_LIMIT=120
# JORD_DATA_RATE_WINDOW_MS=60000
# JORD_IDEMPOTENCY_TTL_MS=86400000
# Outbox CDC retention (S0023). Either cap prunes.
# JORD_CHANGES_RETENTION_DAYS=7
# JORD_CHANGES_RETENTION_ROWS=100000
# Optional live adapter tests:
# JORD_TEST_POSTGRES_URL=postgres://…
# JORD_TEST_LIBSQL_URL=libsql://…  (+ LIBSQL_AUTH_TOKEN or JORD_TEST_LIBSQL_TOKEN)
# S0025 Storage v2 (default local). Flip to s3 only after copy/verify; never delete local in the same step.
# JORD_STORAGE_BACKEND=local
# JORD_STORAGE_BACKEND=s3
# JORD_PUBLIC_BASE_URL=http://127.0.0.1:8787
# JORD_BLOB_SIGNING_SECRET=
# JORD_MAX_BLOB_BYTES=10485760
# JORD_BLOBS_ROOT=
# JORD_S3_BUCKET=
# JORD_S3_ENDPOINT=
# JORD_S3_REGION=auto
# JORD_S3_ACCESS_KEY_ID=
# JORD_S3_SECRET_ACCESS_KEY=
# JORD_S3_FORCE_PATH_STYLE=true
# JORD_S3_PREFIX=
# S0039 OpenTelemetry (off by default; no collector required for tests):
# JORD_OTEL_ENABLED=1
# JORD_OTEL_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=jord-server
# S0073 MailerPort — default console (stdout). Never put provider keys in the DB/UI.
# JORD_MAILER=console
# JORD_MAILER=resend
# JORD_MAIL_FROM=Jord Auth <auth@example.com>
# JORD_RESEND_API_KEY=
# Optional Resend overrides: JORD_RESEND_FROM=  JORD_RESEND_ENDPOINT=https://api.resend.com/emails
# JORD_MAILER=ses
# JORD_SES_REGION=us-east-1
# (or AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN)
# JORD_SES_ACCESS_KEY_ID=
# JORD_SES_SECRET_ACCESS_KEY=
# JORD_SES_SESSION_TOKEN=
# JORD_SES_ENDPOINT=
