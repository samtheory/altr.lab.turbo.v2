{
  "name": "altr-lab",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "workspaces": ["apps/*", "cloud/*", "elements/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:hub": "turbo run dev --filter=@altr/hub",
    "dev:web": "turbo run dev --filter=@altr/web",
    "dev:dashboard": "turbo run dev --filter=@altr/dashboard",
    "dev:trading-ui": "turbo run dev --filter=@altr/trading-ui",
    "dev:api": "turbo run dev --filter=@altr/hono-server",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
