{
  "name": "altr-lab",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "workspaces": [
    "apps/*",
    "cloud/*",
    "elements/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "storybook:ui-kit": "pnpm --filter @altr/apolyx storybook",
    "build:storybook:ui-kit": "pnpm --filter @altr/apolyx build-storybook",
    "dev:apolyx": "turbo run dev --filter=@altr/apolyx-docs",
    "dev:jord": "pnpm --filter @altr/jord-server dev",
    "dev:jord-studio": "pnpm --filter @altr/jord-studio dev",
    "db:snapshot": "pnpm --filter @altr/jord snapshot",
    "cli:apolyx": "pnpm --filter apolyx",
    "clean": "turbo run clean",
    "audit:ci": "node scripts/audit-ci.mjs",
    "audit:all": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "source-map-js": ">=1.2.2",
      "sharp": ">=0.35.5"
    }
  }
}
