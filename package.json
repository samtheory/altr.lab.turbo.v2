{
  "name": "altr-lab",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "workspaces": ["apps/*", "cloud/*", "elements/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "storybook:ui-kit": "pnpm --filter @altr/apolyx storybook",
    "build:storybook:ui-kit": "pnpm --filter @altr/apolyx build-storybook",
    "dev:apolyx": "turbo run dev --filter=@altr/apolyx-docs",
    "dev:jord": "pnpm --filter @altr/jord-server dev",
    "db:snapshot": "pnpm --filter @altr/jord snapshot",
    "cli:apolyx": "pnpm --filter apolyx",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
